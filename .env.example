# Either name works; hubbleflow normalises to GOOGLE_API_KEY.
GOOGLE_API_KEY=

# Optional overrides.
# HUBBLEFLOW_MODEL=google_genai:gemini-3-pro
# HUBBLEFLOW_AUTO_APPROVE=0        # 1 skips every approval prompt
# HUBBLEFLOW_UNSANDBOXED=0         # 1 lets the agent read/write outside the workspace
# NVIDIA_API_KEY=

# Local providers need no key. Point these elsewhere to use another machine.
# OLLAMA_HOST=http://localhost:11434
# MESH_LLM_URL=http://localhost:9337/v1
# FREETOKEN_URL=http://localhost:1919/v1

# HUBBLEFLOW_NUM_CTX=32768         # context window asked of a local model
# HUBBLEFLOW_COMPACT_AFTER=256000  # where a hosted session compacts
# HUBBLEFLOW_KNOWLEDGE=            # an OKF bundle; empty disables the lookup
# HUBBLEFLOW_CONTEXT_FILES=        # empty ignores AGENTS.md / CLAUDE.md

# See the README's Configuration section for the full list.
